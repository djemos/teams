pkgname=teams-for-linux
pkgver=2.0.11
pkgrel=1dj
arch=x86_64
source=("https://github.com/IsmaelMartinez/teams-for-linux/releases/download/v$pkgver/teams-for-linux_${pkgver}_amd64.deb")
url="https://github.com/IsmaelMartinez/teams-for-linux"

slackdesc=\
(
#|-----handy-ruler------------------------------------------------------|
"teams-for-linux (messaging, conferencing and collaboration program)"
"Microsoft Teams is a unified communications platform that combines"
"persistent workplace chat, video meetings and file storage."
"This is the unofficial Microsoft Teams client for Linux."
"It uses the Web App and wrapps it as a standalone application"
"using Electron."
""
