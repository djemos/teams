)

build() {
	
	cd $startdir/src
	ar x ${pkgname}_${pkgver}_amd64.deb || return 1
	tar -xJC $startdir/pkg -f data.tar.xz || return 1
	rm data.tar.xz control.tar.gz || return 1
} 
